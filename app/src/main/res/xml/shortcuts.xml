            android:action="android.intent.action.VIEW"
            android:data="applock://action/lock?minutes=60"
            android:targetPackage="com.archieapps.applock"
            android:targetClass="com.archieapps.applock.automation.AutomationActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="applock_restore"
        android:enabled="true"
        android:shortcutShortLabel="@string/shortcut_restore_short"
        android:shortcutLongLabel="@string/shortcut_restore_long">
