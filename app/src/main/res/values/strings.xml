    <string name="accessibility_service_label">App Locker</string>
    <string name="accessibility_service_description">O App Locker usa este serviço para detectar quando um aplicativo bloqueado é aberto e exibir a tela de desbloqueio. Nenhum conteúdo de tela é lido nem enviado para a internet.</string>

    <string name="setup_title">Diagnóstico</string>
    <string name="setup_intro">Para o bloqueio funcionar de forma confiável, conclua os passos abaixo.</string>
    <string name="setup_accessibility_title">1. Ativar acessibilidade</string>
    <string name="setup_accessibility_desc">Ative em Configurações > Acessibilidade > App Locker para o bloqueio funcionar.</string>
    <string name="setup_accessibility_button">Abrir configurações de acessibilidade</string>
    <string name="setup_overlay_title">2. Sobrepor outros apps (recomendado no Android 12+)</string>
    <string name="setup_overlay_desc">No Android 12 ou superior, esta permissão é o caminho confiável para exibir a tela de bloqueio sobre os outros aplicativos.</string>
    <string name="setup_overlay_button">Permitir sobrepor outros apps</string>
    <string name="setup_pin_title">3. Definir PIN</string>
    <string name="setup_pin_desc">Usado para desbloquear quando a biometria não estiver disponível. Aceita de 4 a 8 dígitos.</string>
    <string name="setup_pin_button_set">Definir PIN</string>
    <string name="setup_pin_button_change">Alterar PIN</string>
    <string name="setup_battery_title">4. Otimização de bateria</string>
    <string name="setup_battery_desc">Desative a otimização de bateria para o App Locker para evitar que o sistema encerre o serviço.</string>
    <string name="setup_battery_button">Abrir configurações de bateria</string>
    <string name="setup_open_apps">Ver aplicativos</string>
