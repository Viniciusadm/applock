    <string name="status_pin_unset">Não definido</string>
    <string name="status_battery_ok">Otimização desativada</string>
    <string name="status_battery_on">Otimização ativa</string>

    <string name="compat_title">Ajustes do fabricante</string>
    <string name="compat_app_settings_button">Abrir configurações do app</string>
    <string name="compat_generic">Alguns fabricantes encerram apps em segundo plano. Se o bloqueio parar de funcionar, permita a execução em segundo plano e o início automático do App Locker nas configurações do sistema.</string>
    <string name="compat_xiaomi">MIUI/HyperOS: ative \"Início automático\" para o App Locker e, em Bateria, defina \"Sem restrições\". Fixe o app nos recentes (ícone de cadeado).</string>
    <string name="compat_huawei">EMUI/HarmonyOS: adicione o App Locker aos \"Apps protegidos\" e ative \"Início automático\" e \"Execução em segundo plano\".</string>
    <string name="compat_samsung">One UI: em Bateria, desative \"Colocar app em suspensão\" e remova o App Locker dos \"Apps em suspensão\" e \"Apps em suspensão profunda\".</string>
    <string name="compat_oppo">ColorOS: ative \"Início automático\" e permita atividade em segundo plano para o App Locker; defina a bateria como \"Não otimizar\".</string>
    <string name="compat_realme">realme UI: ative \"Início automático\" e permita execução em segundo plano; defina a bateria do App Locker como \"Sem restrições\".</string>
    <string name="compat_vivo">Funtouch/OriginOS: ative \"Início automático\" e permita consumo de energia em segundo plano para o App Locker.</string>
    <string name="compat_oneplus">OxygenOS: defina a bateria do App Locker como \"Sem restrições\" e desative a otimização em segundo plano.</string>

